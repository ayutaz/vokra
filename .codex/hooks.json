{
  "description": "Vokra repository policy hooks for Codex.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_use.sh\"",
            "statusMessage": "Checking Vokra command policy",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/guard-protected-path.sh\"",
            "statusMessage": "Protecting owner-owned dirty paths",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "UV_CACHE_DIR=\"${TMPDIR:-/tmp}/vokra-uv-cache\" uv run --no-project --python 3.12 python \"$(git rev-parse --show-toplevel)/.codex/hooks/post_tool_use.py\"",
            "statusMessage": "Formatting and checking Vokra edits",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "UV_CACHE_DIR=\"${TMPDIR:-/tmp}/vokra-uv-cache\" uv run --no-project --python 3.12 python \"$(git rev-parse --show-toplevel)/.codex/hooks/prompt-secret-guard.py\"",
            "statusMessage": "Checking prompt for exposed credentials",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
