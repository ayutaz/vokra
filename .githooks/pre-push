#!/usr/bin/env bash
# Vokra pre-push hook (activate with scripts/install-git-hooks.sh).
#
# Full local gate mirroring CI's compiling checks, so a push does not fail CI
# for something reproducible locally ("run the same commands before pushing",
# CONTRIBUTING.md §2). Slower than pre-commit. Bypass with `git push
# --no-verify` or VOKRA_SKIP_HOOKS=1.
#
# ITERATION-SPEED FAST-PATHS (2026-07-23; allowlist widened 2026-07-27):
#
# * Fast-path (a): if the diff since the tracking upstream (or origin/main
#   when the branch is brand-new) touches ONLY files that cannot affect the
#   Rust build, the clippy + test legs SKIP. Compliance scanner sigpipe
#   test always runs (5 s) — it is trivially cheap and diff-independent.
#
#   Skippable categories (see .githooks/lib-fastpath.sh for the exact
#   patterns and scripts/test-pre-push-fastpath.sh for the 28 pinned cases):
#     - Docs / config: docs/**, .github/**, *.md, *.yml, *.yaml, dotfiles,
#       LICENSE / NOTICE / CHANGELOG / CONTRIBUTING, include/*.h
#     - Offline sidecar Python tools: tools/parity/*.py,
#       tools/parity/{pyproject.toml,uv.lock},
#       tools/parity/vendor/*/{*.py,*.md,LICENSE}
#       (FR-LD-05: not linked into Rust runtime; the only Rust references
#       are docstring citations, never `include_*!` / runtime import)
#     - Fixture hash sidecars: tests/fixtures/*/*.sha256
#       (consumed by CI workflow gate scripts, never by Rust tests directly)
#
#   Any mixture with .rs / Cargo.{toml,lock} / scripts/ / .githooks/ / other
#   tools/* / non-.sha256 under tests/ tips the whole push into the deep
#   path — safety default.
#
# * Fast-path (c): when the deep path DOES run, `cargo nextest run
#   --workspace` is used when `cargo-nextest` is on the developer's PATH
#   (~60% faster than `cargo test`, https://nexte.st). Missing tool falls
#   back to `cargo test --workspace` with a one-line install hint — never
#   a hard error. `cargo nextest` does NOT execute doc-tests, so `cargo
#   test --workspace --doc` runs alongside it.
#
# Neither fast-path silently substitutes correctness: (a) prints why it
# skipped, (c) prints which runner it chose, and both are visible in the
# hook output. Force the full check regardless of diff content with
# VOKRA_HOOK_DEEP=1 (or VOKRA_SKIP_HOOKS=1 for the pre-existing bypass).

set -euo pipefail

if [ "${VOKRA_SKIP_HOOKS:-0}" = "1" ]; then
    echo "pre-push: skipped (VOKRA_SKIP_HOOKS=1)"
    exit 0
fi

# ---------------------------------------------------------------------------
# sccache activation (2026-07-28): `~/.cargo/config.toml` wires
# `rustc-wrapper = "/opt/homebrew/bin/sccache"`, but cargo's default dev
# profile enables incremental compilation, which sccache CANNOT cache
# (Rust limitation — every rustc call reports "UnhandledCompile", cache hit
# rate 0). Exporting `CARGO_INCREMENTAL=0` for the hook forces the classic
# codegen path so sccache actually populates + hits the cache across
# branches / clean rebuilds. Local `cargo build` outside the hook keeps its
# default incremental behavior — we only override for pre-push.
export CARGO_INCREMENTAL=0

# sccache daemon self-heal (2026-07-29): even with rustc-wrapper wired,
# a dead daemon means each cargo invocation spawns a short-lived sccache
# process that cannot persist cache state across rustc calls reliably —
# 2026-07-28 background push measured 11 min wall time with `--show-stats`
# reporting 0 hits, while a warm daemon completes the same workspace check
# in ~1m48s at 94% hit rate. Starting the server explicitly here means the
# first cargo invocation (and every subsequent one in the hook) hits a warm
# cache. Silent on failure so a missing sccache binary never breaks the hook.
if command -v sccache >/dev/null 2>&1; then
    sccache --start-server >/dev/null 2>&1 || true
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# ---------------------------------------------------------------------------
# Fast-path (a): is every file in the push diff documentation-shape?
#
# The classifier lives in .githooks/lib-fastpath.sh so the regression test
# `scripts/test-pre-push-fastpath.sh` can source and drive it directly. An
# empty diff or an unresolvable base falls through to the DEEP path — never
# fast — so a broken symbolic ref cannot accidentally silence the gate.
# ---------------------------------------------------------------------------

# shellcheck source=lib-fastpath.sh
source "$ROOT/.githooks/lib-fastpath.sh"

# ---------------------------------------------------------------------------
# Step 1 always runs: ~5 s, and first so a broken compliance gate is
# reported before the multi-minute clippy/test legs. Proves the NVIDIA
# non-bundle scanners still REJECT a package whose nm dump exceeds the pipe
# buffer — the SIGPIPE fail-open they shipped with.
# ---------------------------------------------------------------------------

echo "pre-push [1/3]: compliance scanner fail-open regression test"
bash scripts/compliance/test-nvidia-scanner-sigpipe.sh

# ---------------------------------------------------------------------------
# Fast-path branch.
# ---------------------------------------------------------------------------

if is_docs_only_diff; then
    echo "pre-push [2/3]: SKIP cargo clippy — $fastpath_reason"
    echo "pre-push [3/3]: SKIP cargo test  — $fastpath_reason"
    echo "pre-push: OK (fast-path — override with VOKRA_HOOK_DEEP=1)"
    exit 0
fi

# ---------------------------------------------------------------------------
# Deep path.
# ---------------------------------------------------------------------------

# Fast-path (d) — 2026-07-28: package-scoped clippy + test when the diff
# only touches specific `crates/<name>/` trees and no root-level build
# config. `changed_workspace_crates` returns the touched crates; we then
# `cargo tree --invert` each to include reverse deps, so a breaking change
# in a shared crate still tests every downstream consumer. `cargo check
# --workspace` still runs as a global compile safety net (~20-40 s, catches
# breakage in crates outside the scoped list).
#
# Silent fall-through: any failure of the classifier / cargo-tree walk
# reverts to `--workspace` — safety default, never silent under-testing.
scoped_args=""
scoped_reason=""
scoped_crates=""
if scoped_crates=$(changed_workspace_crates 2>/dev/null); then
    # shellcheck disable=SC2206  # word-splitting is intentional (newline list → array).
    scoped_arr=($scoped_crates)
    if expanded=$(expand_reverse_deps "${scoped_arr[@]}" 2>/dev/null); then
        # shellcheck disable=SC2206
        expanded_arr=($expanded)
        for c in "${expanded_arr[@]}"; do
            scoped_args="$scoped_args -p $c"
        done
        scoped_reason="package-scoped to $(echo "$expanded" | wc -l | tr -d ' ') workspace crates (touched: $(echo "$scoped_crates" | tr '\n' ',' | sed 's/,$//'))"
    fi
fi

# Fast-path (e) — 2026-07-28: CI-covered heavy tests are skipped locally via
# the nextest `pre-push` profile (`.config/nextest.toml`). Excluded:
#   * vokra-backend-{metal,cuda,vulkan,webgpu,coreml,qnn}
#     – 実 GPU dispatch = M1 Metal で個別 40-60s × N 本 (~50 min の主犯)。
#       CI: macos-latest / Linux+CUDA runner + parity workflows で担保。
#   * vokra-wasm-harness — wasm32 build + browser exec は CI で担保。
#   * vokra-parity — 実 GGUF/checkpoint 依存 integration = parity-*-real.yml。
#
# Skip 対象は `default-filter` で expression 化ゆえ silent 縮小ではない (hook
# 出力に「pre-push profile」明記、CI-covered の説明は .config/nextest.toml
# 冒頭)。VOKRA_HOOK_DEEP=1 で `--profile default` に fallback。
#
# Doc-tests も pre-push から除外 (nextest is not doctest-capable)。
# 個別 doc-test は各 crate compile を trigger する重量 leg = CI territory
# ゆえ、ci-quality.yml の advisory `doctests` job で拾う (2026-08-10 audit
# fix; 以前のコメントは 'CI 側で `cargo test --workspace --doc`' と主張
# していたが実際には CI 内で invoke されていなかった — audit 発見に伴い
# advisory job を新設し、コメント側の主張と実装を整合させた)。

nextest_profile="pre-push"
nextest_skip_reason="CI-covered GPU backends / wasm harness / heavy parity integration are skipped (see .config/nextest.toml)"
if [ "${VOKRA_HOOK_DEEP:-0}" = "1" ]; then
    nextest_profile="default"
    nextest_skip_reason="VOKRA_HOOK_DEEP=1 → full workspace profile"
fi

if [ -n "$scoped_args" ]; then
    echo "pre-push [2/4]: cargo check --workspace  (global compile safety net for $scoped_reason)"
    cargo check --workspace --all-targets
    echo "pre-push [3/4]: cargo clippy $scoped_args --all-targets -- -D warnings  ($scoped_reason)"
    # shellcheck disable=SC2086
    cargo clippy $scoped_args --all-targets -- -D warnings
    if command -v cargo-nextest >/dev/null 2>&1; then
        echo "pre-push [4/4]: cargo nextest run --profile $nextest_profile $scoped_args  ($scoped_reason; $nextest_skip_reason)"
        # shellcheck disable=SC2086
        cargo nextest run --profile "$nextest_profile" $scoped_args
    else
        echo "pre-push [4/4]: cargo test $scoped_args  ($scoped_reason; nextest missing → cannot apply skip-profile filter)"
        echo "  hint: install cargo-nextest to skip CI-covered heavy tests (~50 min saved on M1):"
        echo "        cargo install cargo-nextest --locked"
        # shellcheck disable=SC2086
        cargo test $scoped_args
    fi
else
    echo "pre-push [2/3]: cargo clippy --all-targets -- -D warnings  ($fastpath_reason)"
    cargo clippy --all-targets -- -D warnings

    if command -v cargo-nextest >/dev/null 2>&1; then
        echo "pre-push [3/3]: cargo nextest run --profile $nextest_profile --workspace  ($nextest_skip_reason)"
        cargo nextest run --profile "$nextest_profile" --workspace
    else
        echo "pre-push [3/3]: cargo test --workspace  (nextest missing → cannot apply skip-profile filter)"
        echo "  hint: install cargo-nextest to skip CI-covered heavy tests:"
        echo "        cargo install cargo-nextest --locked"
        cargo test --workspace
    fi
fi

# NOTE: this hook does NOT compile the metal/cuda/vulkan-gated targets. Feature
# unification during `cargo test --workspace` reaches some of them but is not a
# guarantee. Before claiming a change is verified, run:
#     bash scripts/verify.sh
echo "pre-push: OK (feature-gated targets NOT covered — see scripts/verify.sh)"
